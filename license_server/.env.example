# ====================================================================
# Bill Scrapper License Server Configuration
# Rename or copy to .env for local development
# On Render: Add these as Environment Variables in your Web Service Dashboard
# ====================================================================

PORT=3000

# Your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# IMPORTANT: Use the SERVICE_ROLE secret key (not the anon public key)
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key-here...

# Secure random string for admin endpoints (protects /api/admin/generate)
ADMIN_SECRET=change-this-to-a-very-secure-random-secret
